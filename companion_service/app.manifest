<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!--
    LibreHardwareMonitorLib richiede privilegi di amministratore per
    accedere a molti sensori (in particolare temperature CPU/GPU), che
    passano attraverso driver di sistema a basso livello. Senza questo
    manifest, il servizio partirebbe comunque ma alcuni sensori
    risulterebbero vuoti/a zero.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
